#Использовать asserts
#Использовать ".."

// Конструкции OneScript, которых нет во встроенном языке 1С:Предприятие,
// и общие конструкции, разбор которых не должен сломаться при доработках.

Функция Разобрать(Исходник)

	Парсер = Новый ПарсерВстроенногоЯзыка();
	Модуль = Парсер.Разобрать(Исходник);

	Ожидаем.Что(Парсер.ТаблицаОшибок().Количество(), "Ошибки разбора")
		.Равно(0);

	Возврат Модуль;

КонецФункции

#Область ИнструкцияИспользовать

&Тест
Процедура ИспользоватьПростоеИмя() Экспорт

	Модуль = Разобрать("
		|#Использовать asserts
		|А = 1;");

	Ожидаем.Что(Модуль.Объявления[0].Путь, "Имя библиотеки")
		.Равно("asserts");

КонецПроцедуры

&Тест
Процедура ИспользоватьИмяСДефисом() Экспорт

	Модуль = Разобрать("
		|#Использовать autumn-collections
		|А = 1;");

	Ожидаем.Что(Модуль.Объявления[0].Путь, "Имя библиотеки")
		.Равно("autumn-collections");

КонецПроцедуры

&Тест
Процедура ИспользоватьИмяСоСлэшем() Экспорт

	Модуль = Разобрать("
		|#Использовать oint/api/grpc
		|А = 1;");

	Ожидаем.Что(Модуль.Объявления[0].Путь, "Имя библиотеки")
		.Равно("oint/api/grpc");

КонецПроцедуры

