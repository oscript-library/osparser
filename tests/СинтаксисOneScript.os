&Тест
Процедура ИспользоватьИмяСТочкой() Экспорт

	Модуль = Разобрать("
		|#Использовать v8.runner
		|А = 1;");

	Ожидаем.Что(Модуль.Объявления[0].Путь, "Имя библиотеки")
