#КонецОбласти // ПостфиксныеМодификаторы

#Область АсинхронныеМетоды

&Тест
Процедура АсинхроннаяФункция() Экспорт

	Модуль = Разобрать("
		|Асинх Функция Прочитать()
		|	Возврат 1;
		|КонецФункции");

	Ожидаем.Что(Модуль.Объявления[0].Сигнатура.Асинхронный, "Признак асинхронности")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АсинхроннаяПроцедура() Экспорт

	Модуль = Разобрать("
		|Асинх Процедура Записать()
		|КонецПроцедуры");

	Ожидаем.Что(Модуль.Объявления[0].Сигнатура.Асинхронный, "Признак асинхронности")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОператорЖдать() Экспорт

	Разобрать("
		|Асинх Функция Прочитать()
		|	Результат = Ждать ПолучитьДанные();
		|	Возврат Результат;
		|КонецФункции");

КонецПроцедуры

&Тест
Процедура ЖдатьБезПрисваивания() Экспорт

	Разобрать("
		|Асинх Процедура Обработать()
		|	Ждать Сохранить();
		|КонецПроцедуры");

КонецПроцедуры

&Тест
Процедура ОбычнаяФункцияНеАсинхронная() Экспорт

	Модуль = Разобрать("
		|Функция Прочитать()
		|	Возврат 1;
		|КонецФункции");

	Ожидаем.Что(Модуль.Объявления[0].Сигнатура.Асинхронный, "Признак асинхронности")
		.ЭтоЛожь();

КонецПроцедуры

#КонецОбласти // АсинхронныеМетоды

