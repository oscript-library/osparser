КонецПроцедуры

&Тест
Процедура ИспользоватьПутьВКавычках() Экспорт

	Модуль = Разобрать("
		|#Использовать ""./внутренние""
		|А = 1;");

	// путь сохраняется вместе с кавычками, как он записан в исходнике
	Ожидаем.Что(Модуль.Объявления[0].Путь, "Путь")
		.Равно("""./внутренние""");

КонецПроцедуры

#КонецОбласти // ИнструкцияИспользовать

