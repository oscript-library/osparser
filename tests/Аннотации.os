#Использовать asserts
#Использовать ".."

// Аннотации OneScript: произвольные имена, параметры, вложенность, аннотации параметров метода.

Функция Разобрать(Исходник)

	Парсер = Новый ПарсерВстроенногоЯзыка();
	Модуль = Парсер.Разобрать(Исходник);

	Ожидаем.Что(Парсер.ТаблицаОшибок().Количество(), "Ошибки разбора")
		.Равно(0);

	Возврат Модуль;

КонецФункции

Функция ПерваяАннотацияМетода(Модуль)

	Возврат Модуль.Объявления[0].Сигнатура.Аннотации[0];

КонецФункции

&Тест
Процедура АннотацияБезПараметров() Экспорт

	// Когда

	Модуль = Разобрать("
		|&Тест
		|Процедура ТестЧегоТо() Экспорт
		|КонецПроцедуры");

	// Тогда

	Аннотация = ПерваяАннотацияМетода(Модуль);

	Ожидаем.Что(Аннотация.Имя, "Имя аннотации")
		.Равно("Тест");

	Ожидаем.Что(Аннотация.Параметры.Количество(), "Количество параметров")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура АннотацияСПозиционнымПараметром() Экспорт

	// Когда

	Модуль = Разобрать("
		|&ОтображаемоеИмя(""Проверка чего-то"")
		|Процедура ТестЧегоТо() Экспорт
		|КонецПроцедуры");

	// Тогда

	Аннотация = ПерваяАннотацияМетода(Модуль);

	Ожидаем.Что(Аннотация.Имя, "Имя аннотации")
		.Равно("ОтображаемоеИмя");

	Ожидаем.Что(Аннотация.Параметры.Количество(), "Количество параметров")
		.Равно(1);

	Параметр = Аннотация.Параметры[0];

	Ожидаем.Что(Параметр.Имя, "Имя параметра")
		.Равно("");

	Ожидаем.Что(Параметр.Литерал, "Значение параметра")
		.Равно("Проверка чего-то");

КонецПроцедуры

&Тест
Процедура АннотацияСИменованнымПараметром() Экспорт

	// Когда

	Модуль = Разобрать("
		|&Деталька(""OneUnit.Таймаут"", ЗначениеПоУмолчанию = 500)
		|Процедура ТестЧегоТо() Экспорт
		|КонецПроцедуры");

	// Тогда

	Аннотация = ПерваяАннотацияМетода(Модуль);

	Ожидаем.Что(Аннотация.Параметры.Количество(), "Количество параметров")
		.Равно(2);

	Ожидаем.Что(Аннотация.Параметры[0].Имя, "Имя первого параметра")
		.Равно("");

	Ожидаем.Что(Аннотация.Параметры[1].Имя, "Имя второго параметра")
		.Равно("ЗначениеПоУмолчанию");

	Ожидаем.Что(Аннотация.Параметры[1].Литерал, "Значение второго параметра")
		.Равно(500);

КонецПроцедуры

&Тест
Процедура АннотацияСВложеннойАннотацией() Экспорт

	// Когда

	Модуль = Разобрать("
		|&Напильник(ПрименяетсяТолькоНа = &Прозвище(""Желудь""))
		|Процедура ПриСозданииОбъекта()
		|КонецПроцедуры");

	// Тогда

	Аннотация = ПерваяАннотацияМетода(Модуль);

	Ожидаем.Что(Аннотация.Имя, "Имя внешней аннотации")
		.Равно("Напильник");

	Параметр = Аннотация.Параметры[0];

	Ожидаем.Что(Параметр.Имя, "Имя параметра")
		.Равно("ПрименяетсяТолькоНа");

	Ожидаем.Что(Параметр.Значение.Тип, "Тип значения параметра")
		.Равно(Новый ПарсерВстроенногоЯзыка().Типы().ОбъявлениеАннотации);

	Ожидаем.Что(Параметр.Значение.Имя, "Имя вложенной аннотации")
		.Равно("Прозвище");

КонецПроцедуры

&Тест
Процедура НесколькоАннотацийПодряд() Экспорт

	// Когда

	Модуль = Разобрать("
		|&Тест
		|&Тег(""быстрый"")
		|&Таймаут(1000)
		|Процедура ТестЧегоТо() Экспорт
		|КонецПроцедуры");

	// Тогда

	Аннотации = Модуль.Объявления[0].Сигнатура.Аннотации;

	Ожидаем.Что(Аннотации.Количество(), "Количество аннотаций")
		.Равно(3);

	Ожидаем.Что(Аннотации[2].Имя, "Имя третьей аннотации")
		.Равно("Таймаут");

КонецПроцедуры

&Тест
Процедура АннотацияПараметраМетода() Экспорт

	// Когда

	Модуль = Разобрать("
		|&Желудь
		|Процедура ПриСозданииОбъекта(&Пластилин Сервис, Знач Обычный = 1)
		|КонецПроцедуры");

	// Тогда

	Параметры = Модуль.Объявления[0].Сигнатура.Параметры;

	Ожидаем.Что(Параметры.Количество(), "Количество параметров")
		.Равно(2);

	Ожидаем.Что(Параметры[0].Аннотации.Количество(), "Аннотаций у первого параметра")
		.Равно(1);

	Ожидаем.Что(Параметры[0].Аннотации[0].Имя, "Имя аннотации параметра")
		.Равно("Пластилин");

	Ожидаем.Что(Параметры[1].Аннотации.Количество(), "Аннотаций у второго параметра")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура АннотацияПараметраСПараметрами() Экспорт

	// Когда

	Модуль = Разобрать("
		|&Желудь
		|Процедура ПриСозданииОбъекта(&Лог(""oscript.lib.mutatos"") Лог)
		|КонецПроцедуры");

	// Тогда

	Параметр = Модуль.Объявления[0].Сигнатура.Параметры[0];

	Ожидаем.Что(Параметр.Аннотации[0].Имя, "Имя аннотации параметра")
		.Равно("Лог");

	Ожидаем.Что(Параметр.Аннотации[0].Параметры[0].Литерал, "Значение параметра аннотации")
		.Равно("oscript.lib.mutatos");

КонецПроцедуры

&Тест
Процедура АннотацияПеременнойМодуля() Экспорт

	// Когда

	Модуль = Разобрать("
		|&Пластилин
		|Перем Сервис;");

	// Тогда

	Объявление = Модуль.Объявления[0];

	Ожидаем.Что(Объявление.Аннотации.Количество(), "Количество аннотаций")
		.Равно(1);

	Ожидаем.Что(Объявление.Аннотации[0].Имя, "Имя аннотации")
		.Равно("Пластилин");

КонецПроцедуры

&Тест
Процедура ДирективыКомпиляцииНеСломаны() Экспорт

	// Когда

	Модуль = Разобрать("
		|&НаКлиенте
		|Процедура НаКлиенте() Экспорт
		|КонецПроцедуры");

	// Тогда

	Ожидаем.Что(Модуль.Объявления[0].Сигнатура.Директивы.Количество(), "Количество директив")
		.Равно(1);

КонецПроцедуры

&Тест
Процедура АннотацияПередКакРаньше() Экспорт

	// Аннотации 1С разбираются как обычные аннотации, но ИмяМетода остаётся доступным

	// Когда

	Модуль = Разобрать("
		|&Перед(""ИмяМетода"")
		|Процедура Обработчик() Экспорт
		|КонецПроцедуры");

	// Тогда

	Аннотация = ПерваяАннотацияМетода(Модуль);

	Ожидаем.Что(Аннотация.Имя, "Имя аннотации")
		.Равно("Перед");

	Ожидаем.Что(Аннотация.ИмяМетода, "ИмяМетода для совместимости")
		.Равно("ИмяМетода");

КонецПроцедуры
